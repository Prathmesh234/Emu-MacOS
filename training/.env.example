# OpenRouter API (used to access DeepSeek V4 Pro via the chat.completions API).
# DeepSeek uses automatic prefix caching — no cache_control breakpoints needed;
# OpenRouter surfaces hits via usage.prompt_tokens_details.cached_tokens.
# Provider sticky routing also kicks in automatically once the cache is warm.
# See: https://openrouter.ai/docs/features/prompt-caching
# Swap to deepseek/deepseek-v4-flash (~3x cheaper, 284B/13B active) for cheap
# bulk runs; deepseek-v4-pro (1.6T/49B active) is the default for SFT quality.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# GitHub (optional — raises rate limit from 60/hr → 5000/hr when set)
GITHUB_TOKEN=

# Hugging Face (optional — needed for some gated repos; speeds up downloads)
HF_TOKEN=

# Generation
# 32768 is a comfortable default for OSWorld trajectories expanded with
# emu scaffolding (raise_app + plan.md + screenshots ≈ 30–50 messages,
# typical 5–10 k output tokens, long trajectories up to ~15 k). DeepSeek V4
# accepts up to 384 k output tokens, so there's no upstream ceiling pressure.
# `max_tokens` is a CAP not a target — only what the model actually emits
# is billed, so bumping this only costs you on the rare runaway. Lowering
# below 16k risks finish_reason=length failures on long trajectories.
MAX_TOKENS=32768
TEMPERATURE=0.7
