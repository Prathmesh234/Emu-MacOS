# OpenRouter API (used to access Claude Sonnet 4.6 via the chat.completions API
# — see https://openrouter.ai/docs/features/prompt-caching for prompt caching)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional — OpenRouter uses these for analytics / app attribution on its dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=emu-training-synth

# GitHub (optional — raises rate limit from 60/hr → 5000/hr when set)
GITHUB_TOKEN=

# Hugging Face (optional — needed for some gated repos; speeds up downloads)
HF_TOKEN=

# Generation
MAX_TOKENS=8192
TEMPERATURE=0.7
